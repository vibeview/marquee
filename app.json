{
  "expo": {
    "name": "Marquee",
    "slug": "marquee",
    "version": "1.0.0",
    "orientation": "landscape",
    "scheme": "marquee",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F1014",
    "ios": {
      "bundleIdentifier": "io.vibeview.marquee",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "io.vibeview.marquee",
      "adaptiveIcon": {
        "backgroundColor": "#0F1014",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F1014"
        }
      ],
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "androidTVRequired": true,
          "androidTVBanner": "./assets/tv/android-banner-320x180.png",
          "androidTVIcon": "./assets/tv/android-icon-512x512.png",
          "appleTVImages": {
            "icon": "./assets/tv/appletv-icon-1280x768.png",
            "iconSmall": "./assets/tv/appletv-icon-400x240.png",
            "iconSmall2x": "./assets/tv/appletv-icon-800x480.png",
            "topShelf": "./assets/tv/appletv-topshelf-1920x720.png",
            "topShelf2x": "./assets/tv/appletv-topshelf-3840x1440.png",
            "topShelfWide": "./assets/tv/appletv-topshelfwide-2320x720.png",
            "topShelfWide2x": "./assets/tv/appletv-topshelfwide-4640x1440.png"
          }
        }
      ],
      "./plugins/withVibeViewSigning.js",
      "./plugins/withVibeViewIosSigning.js"
    ]
  }
}
